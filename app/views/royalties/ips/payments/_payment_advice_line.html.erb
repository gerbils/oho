<tr id="<%= dom_id(line) %>"
  class="<%= "table-secondary" if line.id == focus_line %>">
  <td class="pe-4"><%= line.invoice_date.strftime("%Y-%m-%d") %></td>
  <td class="pe-4"><%= line.invoice_number %></td>
  <td class="pe-4"><%= line.voucher_id %></td>
  <% if discounts_taken %>
    <td class="text-end pe-4"><%= number_to_currency(line.gross_amount) %></td>
    <td class="text-end pe-4"><%= number_to_currency(line.discount_taken) %></td>
  <% end %>
  <td class="text-end pe-4"><%= number_to_currency(line.paid_amount) %></td>

  <% if line.reconciled? %>
    <td class="text-success text-left pe-4">
      <i class="bi bi-check-circle-fill pe-2" title="Reconciled"></i>
      <% for detail in line.ips_statement_details %>
        <%= link_to(focus_line_royalties_ips_statement_path(
          detail.ips_statement,
          detail,
          anchor: dom_id(detail)
        ), class: "info-link ps-2", title: "View corresponding statement") do %>
        <i class="bi bi-eye fs-4"></i>
      <% end %>
    <% end %>
    </td>
  <% else %>
    <td class="text-secondary text-center pe-4">
      <% if line.ips_payment_advice.status == IpsPaymentAdvice::STATUS_IMPORTED %>
        <i class="bi bi-x-circle" title="Not reconciled"></i>
      <% else %>
        <%= link_to(match_line_royalties_ips_payment_path(line.ips_payment_advice, line_id: line.id),
                    class: "btn btn-sm btn-outline-secondary",
                    title: "Not reconciled: find matching transactions",
                    data: { turbo_frame: "modal" }) do %>
          <i class="bi bi-search"></i>
        <% end %>
      <% end %>
    </td>
  <% end %>
</tr>
